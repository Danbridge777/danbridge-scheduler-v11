{
  "firestore": {
    "rules": "firebase/firestore.rules.deploy"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      ".git/**",
      ".firebase/**",
      "node_modules/**",
      "tests/**",
      "tools/**",
      "docs/**",
      "outputs/**",
      "firebase/**",
      "playwright-report/**",
      "test-results/**",
      "firebase-debug*.log",
      "firestore-debug*.log",
      "*.html",
      "*.png",
      "*.webmanifest",
      "sw.js",
      "js/ui/**"
    ]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.production.json",
      "firebase-debug*.log",
      "firestore-debug*.log",
      "**/.*",
      ".firebase/**",
      ".git/**",
      ".npm-cache/**",
      "**/node_modules/**",
      "CHANGELOG.md",
      "README.md",
      "docs/**",
      "firebase/**",
      "tests/**",
      "tools/**",
      "functions/**",
      "package.json",
      "package-lock.json",
      "playwright.config.js",
      "playwright-report/**",
      "test-results/**"
    ],
    "rewrites": [
      {
        "source": "/api/staging-v2/authority-save",
        "function": {
          "functionId": "stagingV2AuthoritySave",
          "region": "asia-east1"
        }
      }
    ]
  }
}
