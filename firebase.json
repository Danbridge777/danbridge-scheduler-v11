{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".firebase/**",
      ".git/**",
      ".npm-cache/**",
      "**/node_modules/**",
      "CHANGELOG.md",
      "README.md",
      "docs/**",
      "firebase/**",
      "firestore-debug.log",
      "tests/**",
      "tools/**",
      "package.json",
      "package-lock.json",
      "playwright.config.js",
      "playwright-report/**",
      "test-results/**"
    ]
  }
}
