        && request.resource.data.sourceRecordSyncManifestHash == getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.manifestHash
        && getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.schema == 'danbridge-record-sync-control-v1'
        && getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.environment == 'staging'
        && getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.companyId == companyId
        && getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.state == 'active'
        && getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.readTakeover == true
        && getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.writeTakeover == true
        && request.resource.data.safetyRevision == getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.revision
        && request.resource.data.safetyLastEventHash == getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.lastEventHash
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.schema == 'danbridge-record-sync-safety-control-v1'
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.environment == 'staging'
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.companyId == companyId
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.activationEpoch == request.resource.data.activationEpoch
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.state == 'active'
