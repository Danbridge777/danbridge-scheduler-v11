    function validRecordSyncV2ReservationBatchSetSeal(data, registration, companyId, targetV2Epoch, seedId) {
      return data.keys().hasOnly(['schema','state','scope','trustBoundary','completionPolicy','environment','companyId','sourceV1ActivationEpoch','sourceFreezeId','targetV2Epoch','seedId','genesisAuthorityHash','genesisAuthorityAuditHash','genesisAuthorityAuditReceiptHash','registrationHash','registrationAuditHash','reservationManifestHash','sourceRootHash','lineageHash','changesDocumentCount','validAuditIdOccurrenceCount','distinctReservationCount','duplicateAuditIdOccurrenceCount','unreservableCount','batchCount','maxBatchReservations','orderedBatchReceiptHashesHash','batchSummarySetHash','maxBatchArtifactPersistedAt','sealHash','persistedAt','persistedBy','persistedByEmail'])
        && data.schema == 'danbridge-record-sync-v2-change-reservation-batch-set-seal-v1'
        && data.state == 'sealed-batch-set-observation'
        && data.scope == 'dense-r1-receipt-set-seal-not-manifest-cursor-readback-reservation-authority-or-active'
        && data.trustBoundary == 'native-r0-r1-full-replay-and-receipt-only-inventory-admin-bypass-trusted'
        && data.completionPolicy == 'sealed-r1-batch-set-future-m-c-q-r-strict-readback-required'
        && data.environment == 'staging' && companyId == 'danbridge' && data.companyId == companyId
