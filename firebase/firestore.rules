        && request.resource.data.persistedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey();
      allow update: if isOwner()
        && !v1PermanentFenceExists(companyId)
        && legacyV1SafetyMutationAllowed(companyId)
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','activationEpoch','state','revision','lastEventId','lastEventHash','readAllowed','writeAllowed','updatedAt','persistedAt','updatedBy','updatedByEmail'])
        && request.resource.data.schema == resource.data.schema
        && request.resource.data.environment == resource.data.environment
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.activationEpoch == resource.data.activationEpoch
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.readAllowed == true
        && request.resource.data.updatedAt is string
        && request.resource.data.persistedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey()
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(request.resource.data.activationEpoch)/events/$(request.resource.data.lastEventId)).data.eventId == request.resource.data.lastEventId
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(request.resource.data.activationEpoch)/events/$(request.resource.data.lastEventId)).data.eventHash == request.resource.data.lastEventHash
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(request.resource.data.activationEpoch)/events/$(request.resource.data.lastEventId)).data.beforeRevision == resource.data.revision
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(request.resource.data.activationEpoch)/events/$(request.resource.data.lastEventId)).data.afterRevision == request.resource.data.revision
        && ((resource.data.state == 'active'
            && request.resource.data.state == 'paused'
            && request.resource.data.writeAllowed == false
            && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(request.resource.data.activationEpoch)/events/$(request.resource.data.lastEventId)).data.type == 'pause')
          || (resource.data.state == 'paused'
            && request.resource.data.state == 'active'
            && writerAllowsV1SafetyResume(companyId)
            && request.resource.data.writeAllowed == true
            && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(request.resource.data.activationEpoch)/events/$(request.resource.data.lastEventId)).data.type == 'resume'
            && getAfter(/databases/$(database)/documents/stagingRecordSyncRecoveryReceipts/$(companyId)/epochs/$(request.resource.data.activationEpoch)/receipts/$(getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(request.resource.data.activationEpoch)/events/$(request.resource.data.lastEventId)).data.recoveryReceiptHash)).data.state == 'verified'
            && getAfter(/databases/$(database)/documents/stagingRecordSyncRecoveryReceipts/$(companyId)/epochs/$(request.resource.data.activationEpoch)/receipts/$(getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(request.resource.data.activationEpoch)/events/$(request.resource.data.lastEventId)).data.recoveryReceiptHash)).data.pauseEventId == resource.data.lastEventId));
      allow update: if request.resource.data.persistedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey()
