        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.state == 'sealed'
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.candidateEpoch == request.resource.data.candidateEpoch
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.revision == request.resource.data.candidateRevision
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.sealHash == request.resource.data.candidateSealHash
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.legacyVersionHash == request.resource.data.legacyVersionHash
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.recordDataHash == request.resource.data.recordDataHash
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.documentCount == request.resource.data.documentCount
