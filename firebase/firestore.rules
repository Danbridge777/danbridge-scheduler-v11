    match /stagingRecordSyncSafetyEvents/{companyId}/epochs/{activationEpoch}/events/{eventId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && !v1PermanentFenceExists(companyId)
        && legacyV1SafetyMutationAllowed(companyId)
        && companyId == 'danbridge'
        && eventId.matches('[A-Za-z0-9_.:-]{8,128}')
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','activationEpoch','type','eventId','beforeRevision','afterRevision','reason','safeRecordDataHash','cloudBackupId','recoveryReceiptHash','restoredRecordDataHash','createdAt','persistedAt','eventHash','createdBy','createdByEmail'])
