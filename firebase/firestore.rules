        && getAfter(/databases/$(database)/documents/stagingRecordSyncActivationManifests/$(companyId)/manifests/$(request.resource.data.manifestHash)).data.roleViewCount == request.resource.data.roleViewCount
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.schema == 'danbridge-record-sync-safety-control-v1'
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.activationEpoch == request.resource.data.activationEpoch
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.state == 'active'
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.revision == 1
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.lastEventHash == request.resource.data.manifestHash
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.readAllowed == true
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.writeAllowed == true
        && get(/databases/$(database)/documents/companies/$(companyId)/data/main).data.clientHash == request.resource.data.legacyVersionHash
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.state == 'sealed'
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.candidateEpoch == request.resource.data.candidateEpoch
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.revision == request.resource.data.candidateRevision
        && get(/databases/$(database)/documents/stagingRecordSyncCandidateControls/$(companyId)).data.sealHash == request.resource.data.candidateSealHash
