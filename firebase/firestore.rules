        && isRecordSyncV2CutoverOperator(companyId)
        && !v1PermanentFenceExists(companyId)
        && hardPauseWriterTransitionWitness(companyId)
        && hardPauseFreezeControlAllowed(companyId);
      allow update, delete: if false;
    }
    match /stagingRecordSyncV1V2HardPauseReceipts/{companyId}/epochs/{activationEpoch}/freezes/{freezeId} {
      allow read: if isOwner() && companyId == 'danbridge';
