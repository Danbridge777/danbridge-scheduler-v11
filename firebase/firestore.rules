    // 中央安全控制：所有 Owner 裝置共用。暫停只關閉寫入；恢復必須綁定 verified recovery receipt。
    match /stagingRecordSyncSafetyControls/{companyId} {
      allow read: if companyId == 'danbridge' && (isOwner() || activeMember(companyId));
      allow create: if resource == null
        && isOwner()
        && !v1PermanentFenceExists(companyId)
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','activationEpoch','state','revision','lastEventId','lastEventHash','readAllowed','writeAllowed','updatedAt','persistedAt','updatedBy','updatedByEmail'])
        && request.resource.data.schema == 'danbridge-record-sync-safety-control-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.activationEpoch == getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.activationEpoch
        && request.resource.data.state == 'active'
        && request.resource.data.revision == 1
        && request.resource.data.lastEventId == 'activation:' + getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.manifestHash
        && request.resource.data.lastEventHash == getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.manifestHash
        && request.resource.data.readAllowed == true
        && request.resource.data.writeAllowed == true
