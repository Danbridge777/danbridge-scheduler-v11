      let s1 = getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data;
      return root.keys().hasOnly(['schema','environment','companyId','state','activationEpoch','manifestHash','candidateEpoch','candidateRevision','candidateSealHash','legacyVersionHash','recordDataHash','roleEvidenceHash','backupId','restoreReceiptId','collectionCount','documentCount','activeCount','tombstoneCount','roleViewCount','readTakeover','writeTakeover','activatedAt','persistedAt','activatedBy','activatedByEmail'])
        && w0.keys().hasOnly(['schema','environment','companyId','activationEpoch','state','writerProtocol','writerGeneration','revision','admissionOpen','acceptNewSessions','acceptNewMutations','operationPolicy','admissionPolicyToken','currentFreezeId','currentFreezeRequestHash','currentFreezeControlHash','sourceRecordSyncManifestHash','safetyRevision','safetyLastEventHash','lastTransitionHash','minClientProtocolVersion','minClientReleaseId','createdAt','controlHash','persistedAt','persistedBy','persistedByEmail'])
        && w1.keys().hasOnly(['schema','environment','companyId','activationEpoch','state','writerProtocol','writerGeneration','revision','admissionOpen','acceptNewSessions','acceptNewMutations','operationPolicy','admissionPolicyToken','currentFreezeId','currentFreezeRequestHash','currentFreezeControlHash','sourceRecordSyncManifestHash','safetyRevision','safetyLastEventHash','lastTransitionHash','minClientProtocolVersion','minClientReleaseId','createdAt','controlHash','persistedAt','persistedBy','persistedByEmail'])
        && s0.keys().hasOnly(['schema','environment','companyId','activationEpoch','state','revision','lastEventId','lastEventHash','readAllowed','writeAllowed','updatedAt','persistedAt','updatedBy','updatedByEmail'])
        && s1.keys().hasOnly(['schema','environment','companyId','activationEpoch','state','revision','lastEventId','lastEventHash','readAllowed','writeAllowed','updatedAt','persistedAt','updatedBy','updatedByEmail'])
        && root.schema == 'danbridge-record-sync-control-v1' && root.environment == 'staging' && root.companyId == companyId && root.state == 'active' && root.readTakeover == true && root.writeTakeover == true
        && root.activationEpoch == w0.activationEpoch && root.manifestHash == w0.sourceRecordSyncManifestHash && root.activationEpoch == s0.activationEpoch
        && w0.schema == 'danbridge-record-sync-v1-writer-current-v1' && w0.environment == 'staging' && w0.companyId == companyId && w0.state == 'open' && w0.revision == 1 && w0.writerGeneration == 1
        && w0.admissionOpen == true && w0.acceptNewSessions == true && w0.acceptNewMutations == true && w0.operationPolicy == 'v1-open'
        && w1.schema == w0.schema && w1.environment == w0.environment && w1.companyId == w0.companyId && w1.activationEpoch == w0.activationEpoch && w1.writerProtocol == w0.writerProtocol && w1.writerGeneration == w0.writerGeneration && w1.revision == 2
        && w1.state == 'hard-paused' && w1.admissionOpen == false && w1.acceptNewSessions == false && w1.acceptNewMutations == false && w1.operationPolicy == 'hard-pause-all-v1-no-drain'
        && w1.sourceRecordSyncManifestHash == w0.sourceRecordSyncManifestHash && w1.minClientProtocolVersion == w0.minClientProtocolVersion && w1.minClientReleaseId == w0.minClientReleaseId && w1.createdAt == w0.createdAt
        && s0.schema == 'danbridge-record-sync-safety-control-v1' && s0.environment == 'staging' && s0.companyId == companyId && s0.activationEpoch == w0.activationEpoch && s0.state == 'active' && s0.readAllowed == true && s0.writeAllowed == true
        && w0.safetyRevision == s0.revision && w0.safetyLastEventHash == s0.lastEventHash && w0.createdAt == s0.updatedAt
        && s1.schema == s0.schema && s1.environment == s0.environment && s1.companyId == s0.companyId && s1.activationEpoch == s0.activationEpoch && s1.state == 'paused' && s1.revision == s0.revision + 1 && s1.readAllowed == true && s1.writeAllowed == false;
    }
    function hardPauseWriterTransitionWitness(companyId) {
      let w0 = get(/databases/$(database)/documents/stagingRecordSyncV1WriterCurrents/$(companyId)).data;
      let w1 = getAfter(/databases/$(database)/documents/stagingRecordSyncV1WriterCurrents/$(companyId)).data;
      return w0.schema == 'danbridge-record-sync-v1-writer-current-v1'
        && w0.environment == 'staging' && w0.companyId == companyId
        && w0.state == 'open' && w0.revision == 1
        && w1.schema == w0.schema && w1.environment == w0.environment && w1.companyId == w0.companyId
        && w1.activationEpoch == w0.activationEpoch
        && w1.state == 'hard-paused' && w1.revision == 2;
    }
    function hardPauseSafetyTransitionWitness(companyId) {
      let s0 = get(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data;
      let s1 = getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data;
      return s0.schema == 'danbridge-record-sync-safety-control-v1'
        && s0.environment == 'staging' && s0.companyId == companyId
        && s0.state == 'active' && s0.readAllowed == true && s0.writeAllowed == true
        && s1.schema == s0.schema && s1.environment == s0.environment && s1.companyId == s0.companyId
        && s1.activationEpoch == s0.activationEpoch && s1.revision == s0.revision + 1
        && s1.state == 'paused' && s1.readAllowed == true && s1.writeAllowed == false;
    }
    function hardPauseSafetySourceAllowed(companyId) {
      let w0 = get(/databases/$(database)/documents/stagingRecordSyncV1WriterCurrents/$(companyId)).data;
      let w1 = getAfter(/databases/$(database)/documents/stagingRecordSyncV1WriterCurrents/$(companyId)).data;
      let s0 = get(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data;
      let s1 = getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data;
      return s0.keys().hasOnly(['schema','environment','companyId','activationEpoch','state','revision','lastEventId','lastEventHash','readAllowed','writeAllowed','updatedAt','persistedAt','updatedBy','updatedByEmail'])
        && s1.keys().hasOnly(['schema','environment','companyId','activationEpoch','state','revision','lastEventId','lastEventHash','readAllowed','writeAllowed','updatedAt','persistedAt','updatedBy','updatedByEmail'])
        && hardPauseWriterTransitionWitness(companyId)
        && hardPauseSafetyTransitionWitness(companyId)
        && s0.activationEpoch == w0.activationEpoch
        && w0.safetyRevision == s0.revision && w0.safetyLastEventHash == s0.lastEventHash
        && w0.createdAt == s0.updatedAt && s1.updatedAt == s0.updatedAt
        && w1.safetyRevision == s1.revision && w1.safetyLastEventHash == s1.lastEventHash;
    }
    function hardPauseWriterBundleMembershipAllowed(companyId) {
      let w1 = getAfter(/databases/$(database)/documents/stagingRecordSyncV1WriterCurrents/$(companyId)).data;
      let fPath = /databases/$(database)/documents/stagingRecordSyncV2FreezeRequests/$(companyId)/epochs/$(w1.activationEpoch)/freezes/$(w1.currentFreezeId);
      let kPath = /databases/$(database)/documents/stagingRecordSyncV2FreezeControls/$(companyId)/epochs/$(w1.activationEpoch)/freezes/$(w1.currentFreezeId);
      return hardPauseSafetyTransitionWitness(companyId)
        && !exists(fPath) && existsAfter(fPath)
        && !exists(kPath) && existsAfter(kPath);
    }
    function hardPauseSafetyBundleMembershipAllowed(companyId) {
      let w1 = getAfter(/databases/$(database)/documents/stagingRecordSyncV1WriterCurrents/$(companyId)).data;
      let s1 = getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data;
      let pPath = /databases/$(database)/documents/stagingRecordSyncSafetyEvents/$(companyId)/epochs/$(w1.activationEpoch)/events/$(s1.lastEventId);
      let hPath = /databases/$(database)/documents/stagingRecordSyncV1V2HardPauseReceipts/$(companyId)/epochs/$(w1.activationEpoch)/freezes/$(w1.currentFreezeId);
      return hardPauseWriterTransitionWitness(companyId)
        && !exists(pPath) && existsAfter(pPath)
        && !exists(hPath) && existsAfter(hPath);
    }
    function hardPauseFreezeRequestAllowed(companyId) {
      let w0 = get(/databases/$(database)/documents/stagingRecordSyncV1WriterCurrents/$(companyId)).data;
      let w1 = getAfter(/databases/$(database)/documents/stagingRecordSyncV1WriterCurrents/$(companyId)).data;
      let path = /databases/$(database)/documents/stagingRecordSyncV2FreezeRequests/$(companyId)/epochs/$(w1.activationEpoch)/freezes/$(w1.currentFreezeId);
      let f = getAfter(path).data;
      return !exists(path) && f.keys().hasOnly(['schema','environment','companyId','freezeId','activationEpoch','sourceWriterGeneration','targetWriterGeneration','targetV2Epoch','sourceWriterControlHash','minClientProtocolVersion','minClientReleaseId','rulesetHash','preflightRecordDataHash','preflightRawDocumentRoot','preflightBackupId','preflightBackupManifestHash','createdAt','requestHash','persistedAt','persistedBy','persistedByEmail'])
        && f.schema == 'danbridge-record-sync-v2-freeze-request-v1' && f.environment == 'staging' && f.companyId == companyId && f.freezeId == w1.currentFreezeId && f.activationEpoch == w1.activationEpoch
