        && request.resource.data.createdAt == getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.updatedAt
        && nonzeroSha256(request.resource.data.controlHash)
        && request.resource.data.persistedAt == request.time
        && request.resource.data.persistedBy == request.auth.uid
        && request.resource.data.persistedByEmail == emailKey();
      // Only the trusted six-artifact hard-pause transaction may move W0 to W1.
      allow update: if request.resource.data.persistedAt == request.time
        && request.resource.data.persistedBy == request.auth.uid
        && request.resource.data.persistedByEmail == emailKey()
        && isRecordSyncV2CutoverOperator(companyId)
        && !v1PermanentFenceExists(companyId)
