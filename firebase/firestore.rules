        && data.keys().hasAll(['schema','state','scope','environment','companyId','sourceV1ActivationEpoch','targetV2Epoch','authorityRootHash','authorityBoundHeadHash','genesisAuthorityHash','genesisAuthorityAuditHash','changesAuthorityHash','changesAuthorityAuditHash','seedId','sourceRawDocumentRootHash','activeLogicalHashSchema','activeLogicalDataHash','documentCount','activeCount','tombstoneCount','auditedCount','unauditedCount','reservationPlanManifestHash','durableReservationManifestHash','durableCursorHash','strictReservationReadbackReceiptHash','changesDocumentCount','distinctReservationCount','unreservableCount','candidateNextIndex','cursorRevision','writerProtocol','writerGeneration','rulesetHash','minClientProtocolVersion','minClientReleaseId','createdAt','readAllowed','writeAllowed','readTakeoverEnabled','writeTakeoverEnabled','acceptNewSessions','acceptNewMutations','allowAuditAppends','controlHash','persistedAt','persistedBy','persistedByEmail'])
