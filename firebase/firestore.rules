        && activationEpoch == request.resource.data.activationEpoch
        && freezeId == request.resource.data.freezeId
        && request.resource.data.persistedAt == request.time
        && request.resource.data.persistedBy == request.auth.uid
        && request.resource.data.persistedByEmail == emailKey()
        && isRecordSyncV2CutoverOperator(companyId)
        && !v1PermanentFenceExists(companyId)
        && hardPauseWriterTransitionWitness(companyId)
        && hardPauseSafetyTransitionWitness(companyId)
        && hardPauseReceiptAllowed(companyId);
      allow update, delete: if false;
    }
    match /stagingRecordSyncV1PostPauseScans/{companyId}/epochs/{activationEpoch}/freezes/{freezeId}/receipts/{ordinal} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if resource == null
        && ordinal in ['U','V']
        && isRecordSyncV2CutoverOperator(companyId)
        && !v1PermanentFenceExists(companyId)
        && validPostPauseScan(request.resource.data, companyId, activationEpoch, freezeId, ordinal)
        && (ordinal == 'U'
          ? (!existsAfter(/databases/$(database)/documents/stagingRecordSyncV1PostPauseScans/$(companyId)/epochs/$(activationEpoch)/freezes/$(freezeId)/receipts/V)
            && !existsAfter(/databases/$(database)/documents/stagingRecordSyncV1PostPauseScanPairs/$(companyId)/epochs/$(activationEpoch)/freezes/$(freezeId)))
          : validPostPauseVProgression(request.resource.data, companyId, activationEpoch, freezeId));
