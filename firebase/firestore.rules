        && request.resource.data.eventId == eventId
        && request.resource.data.type in ['pause','resume']
        && request.resource.data.beforeRevision is int
        && request.resource.data.afterRevision == request.resource.data.beforeRevision + 1
        && request.resource.data.eventHash.matches('[0-9a-f]{64}')
        && request.resource.data.createdAt is string
        && request.resource.data.persistedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey()
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.lastEventId == eventId
        && getAfter(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.lastEventHash == request.resource.data.eventHash
        && ((request.resource.data.type == 'pause'
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.safeRecordDataHash.matches('record-v1:[0-9a-f]{64}')
            && request.resource.data.cloudBackupId.matches('[A-Za-z0-9_.:-]{8,128}')
            && !('recoveryReceiptHash' in request.resource.data)
            && !('restoredRecordDataHash' in request.resource.data))
          || (request.resource.data.type == 'resume'
            && writerAllowsV1SafetyResume(companyId)
            && !('reason' in request.resource.data)
            && !('safeRecordDataHash' in request.resource.data)
            && !('cloudBackupId' in request.resource.data)
            && request.resource.data.recoveryReceiptHash.matches('[0-9a-f]{64}')
