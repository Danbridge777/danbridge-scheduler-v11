        && isRecordSyncV2CutoverOperator(companyId)
        && !v1PermanentFenceExists(companyId)
        && exists(/databases/$(database)/documents/stagingRecordSyncV1PostPauseScans/$(companyId)/epochs/$(activationEpoch)/freezes/$(freezeId)/receipts/U)
        && exists(/databases/$(database)/documents/stagingRecordSyncV1PostPauseScans/$(companyId)/epochs/$(activationEpoch)/freezes/$(freezeId)/receipts/V)
