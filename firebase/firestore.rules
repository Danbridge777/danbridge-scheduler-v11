        && request.resource.data.admissionOpen == true
        && request.resource.data.acceptNewSessions == true
        && request.resource.data.acceptNewMutations == true
        && request.resource.data.operationPolicy == 'v1-open'
        && request.resource.data.admissionPolicyToken == 'v1-admission:0cd544f29a457c5cb0a8ff0f80d82897896a814cf9811c8ab4d933331602ad90'
        && request.resource.data.currentFreezeId == ''
