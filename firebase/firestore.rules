rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email is string; }
    function emailKey() { return request.auth.token.email.lower(); }
    function isPrimaryOwner() { return signedIn() && emailKey() == 'a0965487920@gmail.com'; }
    function ownerProfileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function ownerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isOwner() {
      return signedIn() && (
        isPrimaryOwner()
        || (accessExists()
          && access().active == true
          && access().companyId == 'danbridge'
          && access().role == 'owner')
      );
    }
    function accessExists() { return signedIn() && exists(/databases/$(database)/documents/companyAccess/$(emailKey())); }
    function access() { return get(/databases/$(database)/documents/companyAccess/$(emailKey())).data; }
    function activeMember(companyId) { return accessExists() && access().active == true && access().companyId == companyId; }
    function currentProfileExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function currentProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function effectiveTeacherId() {
      return access().teacherId is string
        ? access().teacherId
        : (currentProfileExists() && currentProfile().teacherId is string ? currentProfile().teacherId : '');
    }
    function effectiveBranchIds() {
      return access().branchIds is list
        ? access().branchIds
        : (currentProfileExists() && currentProfile().branchIds is list ? currentProfile().branchIds : []);
    }
    function isTeacher(companyId) { return activeMember(companyId) && access().role == 'teacher' && effectiveTeacherId() != ''; }
    function canManageSchedule(companyId) { return isTeacher(companyId) && emailKey() == 'aa0966626336@gmail.com' && access().canManageSchedule == true; }
    function isManager(companyId) { return activeMember(companyId) && access().role == 'branch_manager' && effectiveTeacherId() != ''; }
    function schedulerGrantAllowed(email, data) {
      return !('canManageSchedule' in data) || data.canManageSchedule != true || (
        data.role == 'teacher'
        && email == 'aa0966626336@gmail.com'
      );
    }
    function ownTeacherId() { return effectiveTeacherId(); }
    function ownLessonReport(data) {
      return data.reportedForTeacherIds is list && data.reportedForTeacherIds.hasAny([ownTeacherId()]);
    }
    function managerBranch(data) {
      return data.branchId is string && effectiveBranchIds().hasAny([data.branchId]);
    }
    function metaPath(companyId, lessonId) {
      return /databases/$(database)/documents/companies/$(companyId)/lessonMeta/$(lessonId);
    }
    function metaExists(companyId, lessonId) { return exists(metaPath(companyId, lessonId)); }
    function meta(companyId, lessonId) { return get(metaPath(companyId, lessonId)).data; }
    function withinReportWindow(companyId, lessonId) {
      return meta(companyId, lessonId).editableFrom is timestamp
        && meta(companyId, lessonId).editableUntil is timestamp
        && request.time >= meta(companyId, lessonId).editableFrom
        && request.time <= meta(companyId, lessonId).editableUntil;
    }
    function reportScopeMatchesMeta(companyId, lessonId, data) {
      return data.branchId is string
        && meta(companyId, lessonId).branchId is string
        && data.branchId == meta(companyId, lessonId).branchId
        && data.reportedForTeacherIds is list
        && meta(companyId, lessonId).teacherIds is list
        && data.reportedForTeacherIds.hasOnly(meta(companyId, lessonId).teacherIds)
        && meta(companyId, lessonId).teacherIds.hasOnly(data.reportedForTeacherIds);
    }


    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid
        && (isPrimaryOwner() || (isOwner() && request.resource.data.role != 'owner') || (accessExists()
          && request.resource.data.email.lower() == emailKey()
          && request.resource.data.companyId == access().companyId
          && request.resource.data.role == access().role));
      allow update: if isPrimaryOwner() || (isOwner()
        && resource.data.email.lower() != 'a0965487920@gmail.com'
        && request.resource.data.email.lower() != 'a0965487920@gmail.com'
        && resource.data.role != 'owner'
        && request.resource.data.role != 'owner') || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.active == resource.data.active
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','photoURL','lastLoginAt','updatedAt'
        ])
      ) || (
        signedIn() && request.auth.uid == uid
        && accessExists()
        && access().active == true
        && access().companyId == 'danbridge'
        && access().role == 'owner'
        && request.resource.data.email.lower() == emailKey()
        && request.resource.data.companyId == 'danbridge'
        && request.resource.data.role == 'owner'
        && request.resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','photoURL','lastLoginAt','updatedAt','role','companyId','active'
        ])
      ) || (
        signedIn() && request.auth.uid == uid
        && accessExists()
        && request.resource.data.email.lower() == emailKey()
        && request.resource.data.companyId == access().companyId
        && request.resource.data.role == access().role
        && request.resource.data.active == access().active
        && request.resource.data.teacherId == access().teacherId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','photoURL','lastLoginAt','updatedAt','role','companyId','active',
          'teacherId','teacherName','managerName','branchIds','branchNames','readOnly','canSubmitOwnReports','canManageSchedule'
        ])
      );
      allow delete: if isPrimaryOwner() || (isOwner()
        && resource.data.email.lower() != 'a0965487920@gmail.com'
        && resource.data.role != 'owner');
    }

    match /companyAccess/{email} {
      allow read: if isOwner() || (signedIn() && email == emailKey());
      allow create: if (isPrimaryOwner() || (isOwner()
        && email != 'a0965487920@gmail.com'
        && request.resource.data.role != 'owner'))
        && schedulerGrantAllowed(email, request.resource.data);
      allow update: if (isPrimaryOwner() || (isOwner()
        && email != 'a0965487920@gmail.com'
        && resource.data.role != 'owner'
        && request.resource.data.role != 'owner'))
        && schedulerGrantAllowed(email, request.resource.data);
      allow delete: if isPrimaryOwner() || (isOwner()
        && email != 'a0965487920@gmail.com'
        && resource.data.role != 'owner');
    }

    // 稽核事件位於公司 wildcard 之外，避免 Owner 的公司資料寫入權限覆蓋不可變限制。
    match /companyAudit/{eventId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'companyId','action','category','actorUid','actorEmail','targetType','targetId',
          'changedFields','entityChanges','totalChanges','truncated','beforeHash','afterHash',
          'release','environment','createdAt'
        ])
        && request.resource.data.companyId == 'danbridge'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == emailKey()
        && request.resource.data.action is string
        && request.resource.data.category in ['data','access','backup','system']
        && request.resource.data.changedFields is list
        && request.resource.data.entityChanges is list
        && request.resource.data.totalChanges is int
        && request.resource.data.truncated is bool
        && request.resource.data.environment in ['production','staging']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // staging 逐筆影子資料位於公司 wildcard 外，避免寬鬆 Owner 規則繞過欄位驗證。
    // 目前只驗證 lessons、students、teachers；禁止實體刪除，刪除狀態必須留下墓碑。
    match /stagingRecordShadows/{companyId}/collections/{collectionId}/records/{recordId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && companyId == 'danbridge'
        && collectionId in ['lessons','students','teachers']
        && request.resource.data.keys().hasOnly([
          'companyId','collection','recordId','record','sourceHash','revision','deleted',
          'environment','updatedAt','updatedBy','updatedByEmail'
        ])
        && request.resource.data.companyId == companyId
        && request.resource.data.collection == collectionId
        && request.resource.data.recordId == recordId
        && request.resource.data.record is map
        && request.resource.data.record.id == recordId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.revision is int
        && request.resource.data.revision == 1
        && request.resource.data.deleted is bool
        && request.resource.data.environment == 'staging'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey();
      allow update: if isOwner()
        && companyId == 'danbridge'
        && collectionId in ['lessons','students','teachers']
        && request.resource.data.keys().hasOnly([
          'companyId','collection','recordId','record','sourceHash','revision','deleted',
          'environment','updatedAt','updatedBy','updatedByEmail'
        ])
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.collection == resource.data.collection
        && request.resource.data.recordId == resource.data.recordId
        && request.resource.data.environment == resource.data.environment
        && request.resource.data.companyId == companyId
        && request.resource.data.collection == collectionId
        && request.resource.data.recordId == recordId
        && request.resource.data.record is map
        && request.resource.data.record.id == recordId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.deleted is bool
        && request.resource.data.environment == 'staging'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey();
      allow delete: if false;
    }

    // verified run 與啟用指標位於公司 wildcard 外。它們只描述 staging 影子資料，
    // 不會改變目前讀取來源；啟用指標仍須與 legacy 主文件的 clientHash 完全一致。
    match /stagingRecordShadowRuns/{companyId}/runs/{runId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly([
          'schema','companyId','environment','state','runId','sourceHash','coreHash',
          'documentCount','activeCount','tombstoneCount','createdAt','createdBy','createdByEmail'
        ])
        && request.resource.data.schema == 'danbridge-record-shadow-run-v2'
        && request.resource.data.companyId == companyId
        && request.resource.data.environment == 'staging'
        && request.resource.data.state == 'writing'
        && request.resource.data.runId == runId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.coreHash is string
        && request.resource.data.coreHash.size() > 0
        && request.resource.data.documentCount is int
        && request.resource.data.activeCount is int
        && request.resource.data.tombstoneCount is int
        && request.resource.data.documentCount >= 0
        && request.resource.data.activeCount >= 0
        && request.resource.data.tombstoneCount >= 0
        && request.resource.data.documentCount == request.resource.data.activeCount + request.resource.data.tombstoneCount
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update: if isOwner()
        && companyId == 'danbridge'
        && resource.data.state == 'writing'
        && request.resource.data.keys().hasOnly([
          'schema','companyId','environment','state','runId','sourceHash','coreHash',
          'documentCount','activeCount','tombstoneCount','createdAt','createdBy','createdByEmail',
          'verifiedHash','verifiedAt','verifiedBy','verifiedByEmail'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'state','verifiedHash','verifiedAt','verifiedBy','verifiedByEmail'
        ])
        && request.resource.data.schema == 'danbridge-record-shadow-run-v2'
        && request.resource.data.companyId == companyId
        && request.resource.data.environment == 'staging'
        && request.resource.data.runId == runId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.coreHash is string
        && request.resource.data.coreHash.size() > 0
        && request.resource.data.documentCount is int
        && request.resource.data.activeCount is int
        && request.resource.data.tombstoneCount is int
        && request.resource.data.documentCount >= 0
        && request.resource.data.activeCount >= 0
        && request.resource.data.tombstoneCount >= 0
        && request.resource.data.documentCount == request.resource.data.activeCount + request.resource.data.tombstoneCount
        && request.resource.data.state == 'verified'
        && request.resource.data.verifiedHash == resource.data.sourceHash
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedByEmail == emailKey();
      allow delete: if false;
    }

    match /stagingRecordShadowControls/{companyId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create, update: if isOwner()
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly([
          'schema','companyId','environment','activeRunId','sourceHash','verifiedHash','coreHash',
          'documentCount','activeCount','tombstoneCount','activatedAt','activatedBy','activatedByEmail'
        ])
        && request.resource.data.schema == 'danbridge-record-shadow-activation-v2'
        && request.resource.data.companyId == companyId
        && request.resource.data.environment == 'staging'
        && request.resource.data.activeRunId is string
        && request.resource.data.activeRunId.size() > 0
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.verifiedHash == request.resource.data.sourceHash
        && request.resource.data.coreHash is string
        && request.resource.data.coreHash.size() > 0
        && request.resource.data.documentCount is int
        && request.resource.data.activeCount is int
        && request.resource.data.tombstoneCount is int
        && request.resource.data.documentCount == request.resource.data.activeCount + request.resource.data.tombstoneCount
        && request.resource.data.activatedAt == request.time
        && request.resource.data.activatedBy == request.auth.uid
        && request.resource.data.activatedByEmail == emailKey()
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.schema == 'danbridge-record-shadow-run-v2'
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.companyId == companyId
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.environment == 'staging'
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.runId == request.resource.data.activeRunId
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.state == 'verified'
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.sourceHash == request.resource.data.sourceHash
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.verifiedHash == request.resource.data.verifiedHash
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.coreHash == request.resource.data.coreHash
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.documentCount == request.resource.data.documentCount
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.activeCount == request.resource.data.activeCount
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.tombstoneCount == request.resource.data.tombstoneCount
        && get(/databases/$(database)/documents/companies/$(companyId)/data/main).data.clientHash == request.resource.data.sourceHash;
      allow delete: if false;
    }

    // 遷移前最後防線位於 companies 萬用 Owner 寫入範圍之外。
    // 分片與 verified manifest 只能建立一次；前端 Owner 無法更新或刪除既有備份。
    match /stagingMigrationBackups/{companyId}/runs/{runId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['schema','environment','state','backupId','sourceHash','sourceVersionHash','collectionOrder','collections','chunkCount','recordCount','maxChunkBytes','verifiedHash','verifiedBy','verifiedByEmail','verifiedAt'])
        && request.resource.data.schema == 'danbridge-immutable-migration-backup-v2'
        && request.resource.data.environment == 'staging'
        && request.resource.data.state == 'verified'
        && request.resource.data.backupId == runId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.sourceHash.size() == 64
        && request.resource.data.sourceVersionHash is string
        && request.resource.data.sourceVersionHash.size() > 0
        && request.resource.data.verifiedHash == request.resource.data.sourceHash
        && request.resource.data.collectionOrder is list
        && request.resource.data.collectionOrder.size() == 16
        && request.resource.data.collections is map
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 0
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount >= 0
        && request.resource.data.maxChunkBytes is int
        && request.resource.data.maxChunkBytes >= 4096
        && request.resource.data.maxChunkBytes <= 180000
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedByEmail == emailKey()
        && request.resource.data.verifiedAt == request.time;
      allow update, delete: if false;
    }

    match /stagingMigrationBackups/{companyId}/runs/{runId}/chunks/{chunkId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['schema','environment','backupId','chunkId','collection','index','items','sourceHash','sourceVersionHash','createdAt','createdBy','createdByEmail'])
        && request.resource.data.schema == 'danbridge-immutable-migration-backup-chunk-v2'
        && request.resource.data.environment == 'staging'
        && request.resource.data.backupId == runId
        && request.resource.data.chunkId == chunkId
        && request.resource.data.collection in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.items is list
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.sourceHash.size() == 64
        && request.resource.data.sourceVersionHash is string
        && request.resource.data.sourceVersionHash.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update, delete: if false;
    }

    // 隔離復原演練只寫入專用沙盒；不允許覆寫、刪除或成為正式讀取來源。
    match /stagingMigrationRestoreDrills/{companyId}/runs/{drillId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['schema','environment','state','drillId','sourceBackupId','sourceHash','restoredHash','sourceChunkCount','restoredChunkCount','recordCount','collections','mainVersionHash','mainUnchanged','verifiedAt','verifiedBy','verifiedByEmail'])
        && request.resource.data.schema == 'danbridge-migration-restore-drill-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.state == 'verified'
        && request.resource.data.drillId == drillId
        && request.resource.data.sourceBackupId is string
        && request.resource.data.sourceBackupId.size() > 0
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() == 64
        && request.resource.data.restoredHash == request.resource.data.sourceHash
        && request.resource.data.sourceChunkCount is int
        && request.resource.data.sourceChunkCount >= 0
        && request.resource.data.restoredChunkCount == request.resource.data.sourceChunkCount
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount >= 0
        && request.resource.data.collections is map
        && request.resource.data.mainVersionHash is string
        && request.resource.data.mainVersionHash.size() > 0
        && request.resource.data.mainUnchanged == true
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedByEmail == emailKey();
      allow update, delete: if false;
    }

    match /stagingMigrationRestoreDrills/{companyId}/runs/{drillId}/chunks/{chunkId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['schema','environment','backupId','sourceBackupId','chunkId','collection','index','items','sourceHash','sourceVersionHash','createdAt','createdBy','createdByEmail'])
        && request.resource.data.schema == 'danbridge-immutable-migration-backup-chunk-v2'
        && request.resource.data.environment == 'staging'
        && request.resource.data.backupId == drillId
        && request.resource.data.sourceBackupId is string
        && request.resource.data.sourceBackupId.size() > 0
        && request.resource.data.chunkId == chunkId
        && request.resource.data.collection in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.items is list
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() == 64
        && request.resource.data.sourceVersionHash is string
        && request.resource.data.sourceVersionHash.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update, delete: if false;
    }

    // Owner 對公司命名空間具有完整權限。Firestore 會將重疊 match 以 OR 判斷，
    // 因此 lessonMeta、lessonReports、teacherViews 等新增子集合不會因漏寫 match 而阻擋 Owner。
    match /companies/{companyId}/{document=**} {
      allow read, write: if isOwner();
    }

    match /companies/{companyId}/data/{documentId} {
      allow read, write: if isOwner();
    }

    // 尚未啟用的分片世代可能含完整公司資料；任何老師、排課專員與校區管理者均不可讀寫。
    // Owner 的實際啟用仍須由客戶端交易驗證 legacy hash 與已讀回的完整世代 hash。
    match /companies/{companyId}/shardedGenerations/{generationId} {
      allow read, write: if isOwner();
    }

    match /companies/{companyId}/shardedGenerations/{generationId}/chunks/{chunkId} {
      allow read, write: if isOwner();
    }

    match /companies/{companyId}/shardedControl/{documentId} {
      allow read, write: if isOwner();
    }

    // 三方合併的復原內容含完整衝突欄位，只允許 Owner 存取。
    match /companies/{companyId}/syncConflictBackups/{backupPartId} {
      allow read, write: if isOwner();
    }

    match /companies/{companyId}/teacherViews/{email} {
      allow read: if isOwner() || (signedIn()
        && email == emailKey()
        && isTeacher(companyId)
        && resource.data.teacherId is string
        && resource.data.teacherId == ownTeacherId());
      allow write: if isOwner();
    }

    match /companies/{companyId}/schedulerViews/{email} {
      allow read: if isOwner() || (signedIn() && email == emailKey() && canManageSchedule(companyId));
      allow write: if isOwner();
    }

    match /companies/{companyId}/scheduleRequests/{requestId} {
      allow read: if isOwner() || (canManageSchedule(companyId) && resource.data.actorEmail == emailKey());
      allow create: if canManageSchedule(companyId)
        && request.resource.data.keys().hasOnly(['companyId','operation','lessonId','lesson','student','actorUid','actorEmail','createdAt','status'])
        && request.resource.data.companyId == companyId
        && request.resource.data.operation in ['create','update','delete']
        && request.resource.data.lessonId is string
        && request.resource.data.lesson is map
        && request.resource.data.lesson.keys().hasOnly([
          'id','date','start','end','studentId','teacherId','teacherIds','title','campId',
          'room','location','branchId','deliveryMode','address','onlinePlatform','meetingUrl',
          'status','note','seriesId','lessonState','isDraft'
        ])
        && request.resource.data.lesson.id == request.resource.data.lessonId
        && (!('student' in request.resource.data) || (request.resource.data.student is map
          && request.resource.data.student.keys().hasOnly(['id','name','status','school','grade','level','preferredTeacherId','parent','contact','parentLine','parentEmail','homeAddress','courseType','branchIds'])
          && request.resource.data.student.id == request.resource.data.lesson.studentId
          && request.resource.data.student.name is string))
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == emailKey()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwner();
    }

    match /companies/{companyId}/branchViews/{email} {
      allow read: if isOwner() || (signedIn()
        && email == emailKey()
        && isManager(companyId)
        && resource.data.branchIds is list
        && resource.data.branchIds.hasOnly(effectiveBranchIds())
        && effectiveBranchIds().hasOnly(resource.data.branchIds));
      allow write: if isOwner();
    }

    match /companies/{companyId}/lessonMeta/{lessonId} {
      allow read: if isOwner()
        || (isTeacher(companyId)
          && resource.data.teacherIds is list
          && resource.data.teacherIds.hasAny([ownTeacherId()]))
        || (isManager(companyId) && managerBranch(resource.data));
      allow write: if isOwner();
    }

    match /companies/{companyId}/scheduleNotifications/{notificationId} {
      allow read: if isOwner()
        || (activeMember(companyId)
          && resource.data.recipientEmail == emailKey());
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (activeMember(companyId)
          && resource.data.recipientEmail == emailKey()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read','acknowledgedAt','acknowledgedBy'
          ]));
    }

    match /companies/{companyId}/errorEvents/{eventId} {
      allow read, delete: if isOwner();
      allow update: if false;
      allow create: if (isOwner() || activeMember(companyId))
        && ((isOwner() && request.resource.data.role == 'owner')
          || (activeMember(companyId) && request.resource.data.role == access().role))
        && request.resource.data.keys().hasOnly([
          'release','environment','category','area','code','role','retryable','occurredAt'
        ])
        && request.resource.data.release is string
        && request.resource.data.release.size() <= 24
        && request.resource.data.environment in ['production','staging']
        && request.resource.data.category in ['unhandled','cloud-write','cloud-read','role-view']
        && request.resource.data.area in ['window','promise','owner-upload','owner-snapshot','teacher-view','branch-view','role-publish','access-guard']
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 80
        && request.resource.data.role in ['owner','teacher','branch_manager']
        && request.resource.data.retryable is bool
        && request.resource.data.occurredAt == request.time;
    }

    match /companies/{companyId}/lessonReports/{lessonId} {
      // Read rules must match the listener query fields. Firestore queries are not filters:
      // a collection listener cannot be authorized from lessonMeta lookups alone.
      allow read: if isOwner()
        || (isTeacher(companyId) && ownLessonReport(resource.data))
        || (isManager(companyId) && managerBranch(resource.data));

      // The trusted lessonMeta document and the authenticated account determine permission.
      // Report payload display fields are not used as authorization inputs, preventing harmless
      // UID/teacher-array/legacy-field differences from causing a false permission-denied.
      allow create, update: if isOwner()
        || (
          (isTeacher(companyId) || isManager(companyId))
          && metaExists(companyId, lessonId)
          && meta(companyId, lessonId).active == true
          && meta(companyId, lessonId).teacherIds is list
          && meta(companyId, lessonId).teacherIds.hasAny([ownTeacherId()])
          && request.resource.data.companyId == companyId
          && request.resource.data.lessonId == lessonId
          && reportScopeMatchesMeta(companyId, lessonId, request.resource.data)
          && (isTeacher(companyId)
            || (meta(companyId, lessonId).branchId is string
              && effectiveBranchIds().hasAny([meta(companyId, lessonId).branchId])))
          && withinReportWindow(companyId, lessonId)
        );

      allow delete: if isOwner();
    }
  }
}
