        && isOwner()
        && companyId == 'danbridge'
        && !exists(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId))
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','state','candidateEpoch','legacyVersionHash','recordDataHash','documentCount','activeCount','tombstoneCount','revision','createdAt','sealedAt','readTakeover','writeTakeover','sealHash','persistedAt','updatedBy','updatedByEmail'])
