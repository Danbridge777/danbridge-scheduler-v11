        && request.resource.data.schema == 'danbridge-record-sync-recovery-receipt-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.state == 'verified'
        && request.resource.data.activationEpoch == activationEpoch
        && request.resource.data.pauseEventId == get(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.lastEventId
        && get(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.state == 'paused'
        && get(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.activationEpoch == activationEpoch
        && request.resource.data.sourceBackupId.matches('[A-Za-z0-9_.:-]{8,128}')
        && get(/databases/$(database)/documents/stagingMigrationBackups/$(companyId)/runs/$(request.resource.data.sourceBackupId)).data.state == 'verified'
        && request.resource.data.restoredRecordDataHash.matches('record-v1:[0-9a-f]{64}')
        && request.resource.data.operationLogHash.matches('[0-9a-f]{64}')
