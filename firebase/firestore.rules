        && get(/databases/$(database)/documents/stagingMigrationRestoreDrills/$(companyId)/runs/$(request.resource.data.restoreReceiptId)).data.state == 'verified'
        && get(/databases/$(database)/documents/stagingMigrationRestoreDrills/$(companyId)/runs/$(request.resource.data.restoreReceiptId)).data.sourceBackupId == request.resource.data.backupId
        && get(/databases/$(database)/documents/stagingMigrationRestoreDrills/$(companyId)/runs/$(request.resource.data.restoreReceiptId)).data.mainVersionHash == request.resource.data.legacyVersionHash
