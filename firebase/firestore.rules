        && request.resource.data.deviceId.size() > 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey()
        && getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.state == 'active'
        && getAfter(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.activationEpoch == activationEpoch
        && getAfter(/databases/$(database)/documents/stagingFullRecordShadows/$(companyId)/collections/$(request.resource.data.collection)/records/$(request.resource.data.recordId)).data.lastOperationId == operationId
        && getAfter(/databases/$(database)/documents/stagingFullRecordShadows/$(companyId)/collections/$(request.resource.data.collection)/records/$(request.resource.data.recordId)).data.revision == request.resource.data.revision
        && getAfter(/databases/$(database)/documents/stagingFullRecordShadows/$(companyId)/collections/$(request.resource.data.collection)/records/$(request.resource.data.recordId)).data.deleted == request.resource.data.deleted;
      allow update, delete: if false;
    }

    // 日常逐筆衝突的完整復原內容放在獨立命名空間，避開既有 companies 萬用 Owner 規則。
    // 每個分片只能建立一次，不能覆寫或刪除；寫入時必須仍是同一個 active epoch。
    match /stagingRecordSyncConflictBackups/{companyId}/epochs/{activationEpoch}/parts/{partId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && legacyV1WriteOpen(companyId)
        && companyId == 'danbridge'
        && partId.matches('[A-Za-z0-9_.:-]{8,160}')
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','activationEpoch','backupId','partId','conflictHash','baseHash','targetHash','deviceId','partIndex','partCount','encoding','payload','createdAt','createdBy','createdByEmail'])
        && request.resource.data.schema == 'danbridge-record-sync-conflict-backup-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.activationEpoch == activationEpoch
        && request.resource.data.backupId.matches('[A-Za-z0-9_.:-]{8,128}')
        && request.resource.data.partId == partId
        && request.resource.data.conflictHash.matches('[0-9a-f]{64}')
        && request.resource.data.baseHash.matches('record-v1:[0-9a-f]{64}')
        && request.resource.data.targetHash.matches('record-v1:[0-9a-f]{64}')
        && request.resource.data.deviceId.matches('[A-Za-z0-9_.:-]{1,128}')
        && request.resource.data.partIndex is int
        && request.resource.data.partIndex >= 0
        && request.resource.data.partCount is int
        && request.resource.data.partCount > 0
        && request.resource.data.partIndex < request.resource.data.partCount
        && request.resource.data.encoding == 'json-fragment'
        && request.resource.data.payload is string
        && request.resource.data.payload.size() > 0
        && request.resource.data.payload.size() <= 180000
        && get(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.state == 'active'
        && get(/databases/$(database)/documents/stagingRecordSyncControls/$(companyId)).data.activationEpoch == activationEpoch
        && get(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.state == 'active'
        && get(/databases/$(database)/documents/stagingRecordSyncSafetyControls/$(companyId)).data.activationEpoch == activationEpoch
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update, delete: if false;
    }

    // live 執行 manifest：只能建立一次，並且綁定 verified 備份、復原 receipt 與當下 legacy 版本。
    match /stagingLiveExecutionManifests/{companyId}/runs/{manifestHash} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly([
          'schema','environment','companyId','state','createdAt','backupId','backupSha256','restoreDrillId','legacyVersionHash',
          'operationPlanHash','operationListHash','sourceRecordHash','targetRecordHash','sourceRecordCount','targetRecordCount','sourceCounts','targetCounts',
          'targetDocumentCount','targetActiveCount','targetTombstoneCount','targetDocumentCounts','operationCount','maxOperationsPerRun',
          'plannedExecutionPasses','activationAttemptAllowance','transactionRetryAllowance',
          'estimatedReads','estimatedWrites','readBudget','writeBudget','requiredScenarios','featureFlagOnly','uploadOwnerStateAttached',
          'readTakeover','productionAllowed','manifestHash','persistedAt','persistedBy','persistedByEmail'
        ])
        && request.resource.data.schema == 'danbridge-staging-execution-manifest-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.state == 'ready'
        && request.resource.data.manifestHash == manifestHash
        && manifestHash.matches('[0-9a-f]{64}')
        && request.resource.data.createdAt is string
        && request.resource.data.backupId is string
        && request.resource.data.restoreDrillId is string
        && request.resource.data.legacyVersionHash is string
        && request.resource.data.backupSha256.matches('[0-9a-f]{64}')
        && request.resource.data.operationPlanHash.matches('[0-9a-f]{64}')
        && request.resource.data.operationListHash.matches('[0-9a-f]{64}')
        && request.resource.data.sourceRecordHash.matches('record-v1:[0-9a-f]{64}')
        && request.resource.data.targetRecordHash.matches('record-v1:[0-9a-f]{64}')
        && request.resource.data.sourceRecordCount is int
        && request.resource.data.sourceRecordCount >= 0
        && request.resource.data.targetRecordCount is int
        && request.resource.data.targetRecordCount >= 0
        && request.resource.data.sourceCounts is map
        && request.resource.data.targetCounts is map
        && request.resource.data.targetDocumentCounts is map
        && request.resource.data.targetDocumentCount is int
        && request.resource.data.targetDocumentCount >= 0
        && request.resource.data.targetActiveCount is int
        && request.resource.data.targetActiveCount >= 0
        && request.resource.data.targetActiveCount == request.resource.data.targetRecordCount
        && request.resource.data.targetTombstoneCount is int
        && request.resource.data.targetTombstoneCount >= 0
        && request.resource.data.targetDocumentCount == request.resource.data.targetActiveCount + request.resource.data.targetTombstoneCount
        && request.resource.data.operationCount is int
        && request.resource.data.operationCount >= 0
        && request.resource.data.maxOperationsPerRun is int
        && request.resource.data.maxOperationsPerRun >= 1
        && request.resource.data.maxOperationsPerRun <= 100
        && request.resource.data.plannedExecutionPasses is int
        && request.resource.data.plannedExecutionPasses >= 1
        && request.resource.data.operationCount <= request.resource.data.plannedExecutionPasses * request.resource.data.maxOperationsPerRun
        && (request.resource.data.operationCount == 0 || request.resource.data.operationCount > (request.resource.data.plannedExecutionPasses - 1) * request.resource.data.maxOperationsPerRun)
        && request.resource.data.activationAttemptAllowance == request.resource.data.plannedExecutionPasses + 3
        && request.resource.data.transactionRetryAllowance == 3
        && request.resource.data.estimatedReads is int
        && request.resource.data.estimatedReads == request.resource.data.operationCount * 9 + (request.resource.data.targetDocumentCount + 17) * 2 + request.resource.data.activationAttemptAllowance * 15 + 6
        && request.resource.data.estimatedWrites is int
        && request.resource.data.estimatedWrites == request.resource.data.operationCount * 3 + 3
        && request.resource.data.readBudget is int
        && request.resource.data.writeBudget is int
        && request.resource.data.readBudget >= request.resource.data.estimatedReads
        && request.resource.data.writeBudget >= request.resource.data.estimatedWrites
        && request.resource.data.requiredScenarios == ['create','modify','tombstone','revive','refresh-readback','failure-resume','two-tab-race','role-matrix']
        && request.resource.data.featureFlagOnly == true
        && request.resource.data.uploadOwnerStateAttached == false
        && request.resource.data.readTakeover == false
        && request.resource.data.productionAllowed == false
        && get(/databases/$(database)/documents/stagingMigrationBackups/$(companyId)/runs/$(request.resource.data.backupId)).data.sourceHash == request.resource.data.backupSha256
        && get(/databases/$(database)/documents/stagingMigrationBackups/$(companyId)/runs/$(request.resource.data.backupId)).data.sourceVersionHash == request.resource.data.legacyVersionHash
        && get(/databases/$(database)/documents/stagingMigrationRestoreDrills/$(companyId)/runs/$(request.resource.data.restoreDrillId)).data.sourceBackupId == request.resource.data.backupId
        && get(/databases/$(database)/documents/stagingMigrationRestoreDrills/$(companyId)/runs/$(request.resource.data.restoreDrillId)).data.sourceHash == request.resource.data.backupSha256
        && get(/databases/$(database)/documents/stagingMigrationRestoreDrills/$(companyId)/runs/$(request.resource.data.restoreDrillId)).data.restoredHash == request.resource.data.backupSha256
        && get(/databases/$(database)/documents/stagingMigrationRestoreDrills/$(companyId)/runs/$(request.resource.data.restoreDrillId)).data.mainVersionHash == request.resource.data.legacyVersionHash
        && get(/databases/$(database)/documents/stagingMigrationRestoreDrills/$(companyId)/runs/$(request.resource.data.restoreDrillId)).data.mainUnchanged == true
        && get(/databases/$(database)/documents/companies/$(companyId)/data/main).data.clientHash == request.resource.data.legacyVersionHash
        && request.resource.data.persistedAt == request.time
        && request.resource.data.persistedBy == request.auth.uid
        && request.resource.data.persistedByEmail == emailKey();
      allow update, delete: if false;
    }

    // 低讀取量 live 逐筆層：每次只允許 Owner 原子更新一份 record 與 manifest 綁定控制。
    match /stagingLiveRecords/{companyId}/collections/{collectionId}/records/{recordId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create, update: if isOwner()
        && legacyV1WriteOpen(companyId)
        && companyId == 'danbridge'
        && collectionId in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.keys().hasOnly(['schema','companyId','collection','recordId','record','recordIndex','sourceHash','revision','deleted','environment','lastOperationId','executionManifestHash','updatedAt','updatedBy','updatedByEmail'])
        && request.resource.data.schema == 'danbridge-full-record-shadow-v1'
        && request.resource.data.companyId == companyId
        && request.resource.data.collection == collectionId
        && request.resource.data.recordId == recordId
        && request.resource.data.record is map
        && ((collectionId == 'changes' && request.resource.data.recordIndex is int && request.resource.data.recordIndex >= 0 && recordId.matches('seq_[0-9]{8}_[0-9a-f]{8}')) || (collectionId != 'changes' && request.resource.data.recordIndex == null && request.resource.data.record.id == recordId))
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.deleted is bool
        && request.resource.data.environment == 'staging'
        && request.resource.data.lastOperationId is string
        && request.resource.data.lastOperationId.size() > 0
        && request.resource.data.executionManifestHash.matches('[0-9a-f]{64}')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey()
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.lastOperationId == request.resource.data.lastOperationId
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.lastCollection == collectionId
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.lastRecordId == recordId
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.dataHash == request.resource.data.sourceHash
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.executionManifestHash == request.resource.data.executionManifestHash;
      allow delete: if false;
    }

    // 每筆完成憑證不可覆寫；即使另一台裝置已往後執行，舊操作仍可安全辨認為已完成。
    match /stagingLiveOperationReceipts/{companyId}/runs/{manifestHash}/operations/{operationId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && legacyV1WriteOpen(companyId)
        && companyId == 'danbridge'
        && manifestHash.matches('[0-9a-f]{64}')
        && operationId.size() > 0
        && operationId.size() <= 1500
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','executionManifestHash','operationId','operationHash','collection','recordId','nextHash','revision','deleted','rootRevision','updatedAt','updatedBy','updatedByEmail'])
        && request.resource.data.schema == 'danbridge-live-operation-receipt-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.executionManifestHash == manifestHash
        && request.resource.data.operationId == operationId
        && request.resource.data.operationHash.matches('[0-9a-f]{64}')
        && request.resource.data.collection in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.recordId is string
        && request.resource.data.recordId.size() > 0
        && request.resource.data.nextHash.matches('record-v1:[0-9a-f]{64}')
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.deleted is bool
        && request.resource.data.rootRevision is int
        && request.resource.data.rootRevision >= 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey()
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.executionManifestHash == manifestHash
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.lastOperationId == operationId
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.lastCollection == request.resource.data.collection
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.lastRecordId == request.resource.data.recordId
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.dataHash == request.resource.data.nextHash
        && getAfter(/databases/$(database)/documents/stagingLiveRecordControls/$(companyId)).data.rootRevision == request.resource.data.rootRevision
        && getAfter(/databases/$(database)/documents/stagingLiveRecords/$(companyId)/collections/$(request.resource.data.collection)/records/$(request.resource.data.recordId)).data.lastOperationId == operationId
        && getAfter(/databases/$(database)/documents/stagingLiveRecords/$(companyId)/collections/$(request.resource.data.collection)/records/$(request.resource.data.recordId)).data.revision == request.resource.data.revision
        && getAfter(/databases/$(database)/documents/stagingLiveRecords/$(companyId)/collections/$(request.resource.data.collection)/records/$(request.resource.data.recordId)).data.deleted == request.resource.data.deleted;
      allow update, delete: if false;
    }

    match /stagingLiveRecordControls/{companyId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if resource == null
        && isOwner()
        && legacyV1WriteOpen(companyId)
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','state','executionManifestHash','backupId','restoreDrillId','legacyVersionHash','dataHash','targetDataHash','rootRevision','executionBaseRootRevision','operationCount','confirmedOperationCount','expectedDocumentCount','expectedActiveCount','expectedTombstoneCount','lastOperationId','lastCollection','lastRecordId','verifiedHash','verifiedDocumentCount','verifiedActiveCount','verifiedTombstoneCount','updatedAt','updatedBy','updatedByEmail'])
        && request.resource.data.schema == 'danbridge-live-record-control-v2'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && ((request.resource.data.operationCount == 0 && request.resource.data.state == 'verifying') || (request.resource.data.operationCount > 0 && request.resource.data.state == 'migrating'))
        && existsAfter(/databases/$(database)/documents/stagingLiveExecutionManifests/$(companyId)/runs/$(request.resource.data.executionManifestHash))
        && liveControlMatchesManifest(companyId)
        && request.resource.data.rootRevision == 0
        && request.resource.data.executionBaseRootRevision == 0
        && request.resource.data.confirmedOperationCount == 0
        && request.resource.data.lastOperationId == ''
        && request.resource.data.lastCollection == ''
        && request.resource.data.lastRecordId == ''
        && request.resource.data.verifiedHash == ''
        && request.resource.data.verifiedDocumentCount == 0
        && request.resource.data.verifiedActiveCount == 0
        && request.resource.data.verifiedTombstoneCount == 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey();
      allow update: if resource != null
        && isOwner()
        && legacyV1WriteOpen(companyId)
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','state','executionManifestHash','backupId','restoreDrillId','legacyVersionHash','dataHash','targetDataHash','rootRevision','executionBaseRootRevision','operationCount','confirmedOperationCount','expectedDocumentCount','expectedActiveCount','expectedTombstoneCount','lastOperationId','lastCollection','lastRecordId','verifiedHash','verifiedDocumentCount','verifiedActiveCount','verifiedTombstoneCount','updatedAt','updatedBy','updatedByEmail'])
        && request.resource.data.schema == resource.data.schema
        && request.resource.data.environment == resource.data.environment
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey()
        && (resource.data.state == 'migrating'
          ? liveControlMigrationIsValid(companyId)
          : (resource.data.state == 'verifying'
            ? liveControlFinalizationIsValid()
            : (resource.data.state == 'active' ? liveControlRearmIsValid(companyId) : false)));
      allow delete: if false;
    }

    // production 初始逐筆遷移命名空間；不接管任何讀取，禁止非 Owner 與實體刪除。
    match /productionFullRecordShadows/{companyId}/collections/{collectionId}/records/{recordId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && legacyV1WriteOpen(companyId)
        && companyId == 'danbridge'
        && collectionId in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.keys().hasOnly(['schema','companyId','collection','recordId','record','recordIndex','sourceHash','revision','deleted','environment','updatedAt','updatedBy','updatedByEmail'])
        && request.resource.data.schema == 'danbridge-full-record-shadow-v1'
        && request.resource.data.companyId == companyId
        && request.resource.data.collection == collectionId
        && request.resource.data.recordId == recordId
        && request.resource.data.record is map
        && ((collectionId == 'changes' && request.resource.data.recordIndex is int && request.resource.data.recordIndex >= 0 && recordId.matches('seq_[0-9]{8}_[0-9a-f]{8}')) || (collectionId != 'changes' && request.resource.data.recordIndex == null && request.resource.data.record.id == recordId))
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.revision == 1
        && request.resource.data.deleted is bool
        && request.resource.data.environment == 'production'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey();
      allow update: if isOwner()
        && legacyV1WriteOpen(companyId)
        && companyId == 'danbridge'
        && collectionId in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.keys().hasOnly(['schema','companyId','collection','recordId','record','recordIndex','sourceHash','revision','deleted','environment','updatedAt','updatedBy','updatedByEmail'])
        && request.resource.data.schema == resource.data.schema
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.collection == resource.data.collection
        && request.resource.data.recordId == resource.data.recordId
        && request.resource.data.environment == resource.data.environment
        && request.resource.data.companyId == companyId
        && request.resource.data.collection == collectionId
        && request.resource.data.recordId == recordId
        && request.resource.data.record is map
        && ((collectionId == 'changes' && request.resource.data.recordIndex is int && request.resource.data.recordIndex >= 0 && recordId.matches('seq_[0-9]{8}_[0-9a-f]{8}')) || (collectionId != 'changes' && request.resource.data.recordIndex == null && request.resource.data.record.id == recordId))
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.deleted is bool
        && request.resource.data.environment == 'production'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == emailKey();
      allow delete: if false;
    }

    // aa／老師／校區管理者的逐筆即時檢視。Owner 先逐筆寫完並完整讀回，最後才更新小型控制；
    // 讀取端只有在控制的 viewKey、權限 scope、世代與逐筆 hash 全部一致時才會換畫面。
    match /stagingRoleRecordViewControls/{companyId}/views/{email} {
      // 啟用前本人的控制文件必須能以「不存在」正常讀回，角色端才能安全維持 legacy。
      // 僅按已驗證的登入信箱開放本人路徑；實際角色資料仍由下方 scope、root epoch 與 hash 規則保護。
      allow read: if isOwner() || (companyId == 'danbridge'
        && email == emailKey()
        && activeMember(companyId));
      allow create, update: if roleRecordControlWriteIsValid(companyId, email);
      allow delete: if false;
    }

    match /stagingRoleRecordViews/{companyId}/views/{viewKey}/collections/{collectionId}/records/{recordId} {
      allow get: if isOwner() || (companyId == 'danbridge'
        && ownRoleRecordScopeMatches(companyId, resource.data.email, resource.data)
        && activeRoleRecordViewMatches(companyId, resource.data.email, viewKey, resource.data));
      allow list: if isOwner() || (signedIn()
        && companyId == 'danbridge'
        && ownRoleRecordViewListIsAllowed(companyId, viewKey));
      allow create, update: if roleRecordWriteIsValid(companyId, viewKey, collectionId, recordId);
      allow delete: if false;
    }

    // 角色候選 manifest 只在全部 view 逐筆讀回後建立，並永久綁定 run/sourceHash。
    match /stagingRoleViewCandidateManifests/{companyId}/runs/{runId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && companyId == 'danbridge'
        && runId.matches('[A-Za-z0-9_.:%@+-]{1,256}')
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','state','runId','sourceHash','viewCount','documentCount','views','createdAt','manifestHash','persistedAt','persistedBy','persistedByEmail'])
        && request.resource.data.schema == 'danbridge-role-view-candidate-manifest-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.state == 'verified'
        && request.resource.data.runId == runId
        && request.resource.data.sourceHash.matches('[0-9a-f]{64}')
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount > 0
        && request.resource.data.documentCount is int
        && request.resource.data.documentCount >= 0
        && request.resource.data.views is list
        && request.resource.data.views.size() == request.resource.data.viewCount
        && request.resource.data.createdAt is string
        && request.resource.data.manifestHash.matches('[0-9a-f]{64}')
        && request.resource.data.persistedAt == request.time
        && request.resource.data.persistedBy == request.auth.uid
        && request.resource.data.persistedByEmail == emailKey();
      allow update, delete: if false;
    }

    // 每個登入者必須親自完成 16 集合、即時監聽與拒絕測試，憑證只能建立一次。
    match /stagingRoleViewVerificationReceipts/{companyId}/runs/{runId}/actors/{actorEmail} {
      // 本人建立不可變憑證前，交易必須先讀取同一路徑確認不存在。
      // 非 Owner 僅能讀取自己的 actorEmail，且帳號必須仍是啟用成員；
      // 不依賴 resource.data，避免不存在的文件在 transaction.get 階段被誤擋。
      allow read: if companyId == 'danbridge'
        && (isOwner() || (signedIn()
          && actorEmail == emailKey()
          && activeMember(companyId)));
      allow create: if companyId == 'danbridge'
        && actorEmail == emailKey()
        && runId.matches('[A-Za-z0-9_.:%@+-]{1,256}')
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','state','runId','sourceHash','manifestHash','email','kind','viewId','viewHash','verifiedViewCount','collectionCount','documentCount','realtimeObserved','directCoreDenied','crossRoleDenied','readTakeover','writeTakeover','testedAt','receiptHash','persistedAt','verifiedBy','verifiedByEmail'])
        && request.resource.data.schema == 'danbridge-role-view-verification-receipt-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.state == 'verified'
        && request.resource.data.runId == runId
        && request.resource.data.sourceHash.matches('[0-9a-f]{64}')
        && request.resource.data.manifestHash.matches('[0-9a-f]{64}')
        && request.resource.data.email == actorEmail
        && request.resource.data.kind in ['owner','scheduler','teacher','branch_manager']
        && request.resource.data.viewId is string
        && request.resource.data.viewHash.matches('[0-9a-f]{64}')
        && request.resource.data.verifiedViewCount is int
        && request.resource.data.verifiedViewCount > 0
        && request.resource.data.collectionCount == 16
        && request.resource.data.documentCount is int
        && request.resource.data.documentCount >= 0
        && request.resource.data.realtimeObserved == true
        && request.resource.data.readTakeover == false
        && request.resource.data.writeTakeover == false
        && request.resource.data.testedAt is string
        && request.resource.data.receiptHash.matches('[0-9a-f]{64}')
        && get(/databases/$(database)/documents/stagingRoleViewCandidateManifests/$(companyId)/runs/$(runId)).data.state == 'verified'
        && get(/databases/$(database)/documents/stagingRoleViewCandidateManifests/$(companyId)/runs/$(runId)).data.sourceHash == request.resource.data.sourceHash
        && get(/databases/$(database)/documents/stagingRoleViewCandidateManifests/$(companyId)/runs/$(runId)).data.manifestHash == request.resource.data.manifestHash
        && ((request.resource.data.kind == 'owner'
            && isOwner()
            && request.resource.data.viewId == ''
            && request.resource.data.viewHash == request.resource.data.manifestHash
            && request.resource.data.verifiedViewCount == get(/databases/$(database)/documents/stagingRoleViewCandidateManifests/$(companyId)/runs/$(runId)).data.viewCount
            && request.resource.data.documentCount == get(/databases/$(database)/documents/stagingRoleViewCandidateManifests/$(companyId)/runs/$(runId)).data.documentCount
            && request.resource.data.directCoreDenied == false
            && request.resource.data.crossRoleDenied == false)
          || (request.resource.data.kind != 'owner'
            && roleViewCandidateTargetMatches(companyId, actorEmail, request.resource.data.kind)
            && request.resource.data.viewId.matches('[A-Za-z0-9_.:%@+-]{1,256}')
            && request.resource.data.verifiedViewCount == 1
            && request.resource.data.directCoreDenied == true
            && request.resource.data.crossRoleDenied == true))
        && request.resource.data.persistedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedByEmail == emailKey();
      allow update, delete: if false;
    }

    // 角色檢視逐筆候選：每個 run 完全隔離且不可覆寫；尚未成為 aa／老師／管理者讀取來源。
    match /stagingRoleViewCandidates/{companyId}/runs/{runId}/views/{viewId}/collections/{collectionId}/records/{recordId} {
      allow read: if companyId == 'danbridge'
        && (isOwner() || ownRoleViewCandidateMatches(companyId, resource.data));
      allow create: if isOwner()
        && companyId == 'danbridge'
        && !exists(/databases/$(database)/documents/stagingRoleViewCandidateManifests/$(companyId)/runs/$(runId))
        && collectionId in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','runId','sourceHash','viewId','email','kind','viewHash','collection','recordId','record','recordIndex','createdAt','createdBy','createdByEmail'])
        && request.resource.data.schema == 'danbridge-role-view-candidate-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.runId == runId
        && request.resource.data.viewId == viewId
        && request.resource.data.collection == collectionId
        && request.resource.data.recordId == recordId
        && request.resource.data.email is string
        && request.resource.data.kind in ['scheduler','teacher','branch_manager']
        && roleViewCandidateTargetMatches(companyId, request.resource.data.email, request.resource.data.kind)
        && request.resource.data.sourceHash.matches('[0-9a-f]{64}')
        && request.resource.data.viewHash.matches('[0-9a-f]{64}')
        && request.resource.data.record is map
        && request.resource.data.recordIndex is int && request.resource.data.recordIndex >= 0
        && ((collectionId == 'changes' && recordId.matches('seq_[0-9]{8}_[0-9a-f]{8}')) || (collectionId != 'changes' && request.resource.data.record.id == recordId))
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update, delete: if false;
    }

    match /productionRoleViewCandidates/{companyId}/runs/{runId}/views/{viewId}/collections/{collectionId}/records/{recordId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && companyId == 'danbridge'
        && collectionId in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.keys().hasOnly(['schema','environment','companyId','runId','sourceHash','viewId','email','kind','viewHash','collection','recordId','record','recordIndex','createdAt','createdBy','createdByEmail'])
        && request.resource.data.schema == 'danbridge-role-view-candidate-v1'
        && request.resource.data.environment == 'production'
        && request.resource.data.companyId == companyId
        && request.resource.data.runId == runId
        && request.resource.data.viewId == viewId
        && request.resource.data.collection == collectionId
        && request.resource.data.recordId == recordId
        && request.resource.data.email is string
        && request.resource.data.kind in ['scheduler','teacher','branch_manager']
        && request.resource.data.sourceHash is string && request.resource.data.sourceHash.size() >= 8
        && request.resource.data.viewHash is string && request.resource.data.viewHash.size() >= 8
        && request.resource.data.record is map
        && request.resource.data.recordIndex is int && request.resource.data.recordIndex >= 0
        && ((collectionId == 'changes' && recordId.matches('seq_[0-9]{8}_[0-9a-f]{8}')) || (collectionId != 'changes' && request.resource.data.record.id == recordId))
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update, delete: if false;
    }

    // staging 原子啟用證據。manifest 只能在候選完整讀回後建立且不可覆寫；
    // control 仍明確關閉讀寫接管，僅作為下一階段的 fail-closed 驗證點。
    match /stagingRecordCandidateManifests/{companyId}/manifests/{manifestId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly([
          'schema','kind','environment','companyId','state','verified','manifestId','runId',
          'sourceHash','verifiedHash','collectionCount','documentCount','activeCount','tombstoneCount',
          'viewCount','createdAt','createdBy','createdByEmail'
        ])
        && request.resource.data.schema == 'danbridge-record-candidate-manifest-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.manifestId == manifestId
        && request.resource.data.state == 'verified'
        && request.resource.data.verified == true
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() >= 8
        && request.resource.data.verifiedHash == request.resource.data.sourceHash
        && request.resource.data.documentCount is int
        && request.resource.data.documentCount >= 0
        && (
          (request.resource.data.kind == 'full-records'
            && request.resource.data.keys().hasAll(['collectionCount','activeCount','tombstoneCount'])
            && request.resource.data.collectionCount == 16
            && request.resource.data.activeCount is int
            && request.resource.data.activeCount >= 0
            && request.resource.data.tombstoneCount is int
            && request.resource.data.tombstoneCount >= 0
            && request.resource.data.documentCount == request.resource.data.activeCount + request.resource.data.tombstoneCount)
          || (request.resource.data.kind == 'role-views'
            && request.resource.data.keys().hasAll(['runId','viewCount'])
            && request.resource.data.runId is string
            && request.resource.data.runId.size() >= 8
            && request.resource.data.viewCount is int
            && request.resource.data.viewCount > 0
            && request.resource.data.documentCount >= request.resource.data.viewCount)
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update, delete: if false;
    }

    match /stagingRecordActivationControls/{companyId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create, update: if isOwner()
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly([
          'schema','environment','companyId','state','sourceHash','fullManifestId','roleManifestId',
          'fullVerifiedHash','roleVerifiedHash','roleRunId','collectionCount','documentCount',
          'activeCount','tombstoneCount','viewCount','roleDocumentCount','readTakeover','writeTakeover',
          'activatedAt','activatedBy','activatedByEmail'
        ])
        && request.resource.data.schema == 'danbridge-record-activation-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.companyId == companyId
        && request.resource.data.state == 'verified'
        && request.resource.data.readTakeover == false
        && request.resource.data.writeTakeover == false
        && request.resource.data.activatedAt == request.time
        && request.resource.data.activatedBy == request.auth.uid
        && request.resource.data.activatedByEmail == emailKey()
        && get(/databases/$(database)/documents/companies/$(companyId)/data/main).data.clientHash == request.resource.data.sourceHash
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.fullManifestId)).data.kind == 'full-records'
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.fullManifestId)).data.state == 'verified'
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.fullManifestId)).data.sourceHash == request.resource.data.sourceHash
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.fullManifestId)).data.verifiedHash == request.resource.data.fullVerifiedHash
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.fullManifestId)).data.collectionCount == request.resource.data.collectionCount
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.fullManifestId)).data.documentCount == request.resource.data.documentCount
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.fullManifestId)).data.activeCount == request.resource.data.activeCount
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.fullManifestId)).data.tombstoneCount == request.resource.data.tombstoneCount
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.roleManifestId)).data.kind == 'role-views'
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.roleManifestId)).data.state == 'verified'
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.roleManifestId)).data.sourceHash == request.resource.data.sourceHash
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.roleManifestId)).data.verifiedHash == request.resource.data.roleVerifiedHash
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.roleManifestId)).data.runId == request.resource.data.roleRunId
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.roleManifestId)).data.viewCount == request.resource.data.viewCount
        && getAfter(/databases/$(database)/documents/stagingRecordCandidateManifests/$(companyId)/manifests/$(request.resource.data.roleManifestId)).data.documentCount == request.resource.data.roleDocumentCount;
      allow delete: if false;
    }

    // verified run 與啟用指標位於公司 wildcard 外。它們只描述 staging 影子資料，
    // 不會改變目前讀取來源；啟用指標仍須與 legacy 主文件的 clientHash 完全一致。
    match /stagingRecordShadowRuns/{companyId}/runs/{runId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create: if isOwner()
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly([
          'schema','companyId','environment','state','runId','sourceHash','coreHash',
          'documentCount','activeCount','tombstoneCount','createdAt','createdBy','createdByEmail'
        ])
        && request.resource.data.schema == 'danbridge-record-shadow-run-v2'
        && request.resource.data.companyId == companyId
        && request.resource.data.environment == 'staging'
        && request.resource.data.state == 'writing'
        && request.resource.data.runId == runId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.coreHash is string
        && request.resource.data.coreHash.size() > 0
        && request.resource.data.documentCount is int
        && request.resource.data.activeCount is int
        && request.resource.data.tombstoneCount is int
        && request.resource.data.documentCount >= 0
        && request.resource.data.activeCount >= 0
        && request.resource.data.tombstoneCount >= 0
        && request.resource.data.documentCount == request.resource.data.activeCount + request.resource.data.tombstoneCount
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update: if isOwner()
        && companyId == 'danbridge'
        && resource.data.state == 'writing'
        && request.resource.data.keys().hasOnly([
          'schema','companyId','environment','state','runId','sourceHash','coreHash',
          'documentCount','activeCount','tombstoneCount','createdAt','createdBy','createdByEmail',
          'verifiedHash','verifiedAt','verifiedBy','verifiedByEmail'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'state','verifiedHash','verifiedAt','verifiedBy','verifiedByEmail'
        ])
        && request.resource.data.schema == 'danbridge-record-shadow-run-v2'
        && request.resource.data.companyId == companyId
        && request.resource.data.environment == 'staging'
        && request.resource.data.runId == runId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.coreHash is string
        && request.resource.data.coreHash.size() > 0
        && request.resource.data.documentCount is int
        && request.resource.data.activeCount is int
        && request.resource.data.tombstoneCount is int
        && request.resource.data.documentCount >= 0
        && request.resource.data.activeCount >= 0
        && request.resource.data.tombstoneCount >= 0
        && request.resource.data.documentCount == request.resource.data.activeCount + request.resource.data.tombstoneCount
        && request.resource.data.state == 'verified'
        && request.resource.data.verifiedHash == resource.data.sourceHash
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedByEmail == emailKey();
      allow delete: if false;
    }

    match /stagingRecordShadowControls/{companyId} {
      allow read: if isOwner() && companyId == 'danbridge';
      allow create, update: if isOwner()
        && companyId == 'danbridge'
        && request.resource.data.keys().hasOnly([
          'schema','companyId','environment','activeRunId','sourceHash','verifiedHash','coreHash',
          'documentCount','activeCount','tombstoneCount','activatedAt','activatedBy','activatedByEmail'
        ])
        && request.resource.data.schema == 'danbridge-record-shadow-activation-v2'
        && request.resource.data.companyId == companyId
        && request.resource.data.environment == 'staging'
        && request.resource.data.activeRunId is string
        && request.resource.data.activeRunId.size() > 0
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.verifiedHash == request.resource.data.sourceHash
        && request.resource.data.coreHash is string
        && request.resource.data.coreHash.size() > 0
        && request.resource.data.documentCount is int
        && request.resource.data.activeCount is int
        && request.resource.data.tombstoneCount is int
        && request.resource.data.documentCount == request.resource.data.activeCount + request.resource.data.tombstoneCount
        && request.resource.data.activatedAt == request.time
        && request.resource.data.activatedBy == request.auth.uid
        && request.resource.data.activatedByEmail == emailKey()
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.schema == 'danbridge-record-shadow-run-v2'
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.companyId == companyId
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.environment == 'staging'
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.runId == request.resource.data.activeRunId
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.state == 'verified'
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.sourceHash == request.resource.data.sourceHash
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.verifiedHash == request.resource.data.verifiedHash
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.coreHash == request.resource.data.coreHash
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.documentCount == request.resource.data.documentCount
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.activeCount == request.resource.data.activeCount
        && get(/databases/$(database)/documents/stagingRecordShadowRuns/$(companyId)/runs/$(request.resource.data.activeRunId)).data.tombstoneCount == request.resource.data.tombstoneCount
        && get(/databases/$(database)/documents/companies/$(companyId)/data/main).data.clientHash == request.resource.data.sourceHash;
      allow delete: if false;
    }

    // 遷移前最後防線位於 companies 萬用 Owner 寫入範圍之外。
    // 分片與 verified manifest 只能建立一次；前端 Owner 無法更新或刪除既有備份。
    match /stagingMigrationBackups/{companyId}/runs/{runId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['schema','environment','state','backupId','sourceHash','sourceVersionHash','collectionOrder','collections','chunkCount','recordCount','maxChunkBytes','verifiedHash','verifiedBy','verifiedByEmail','verifiedAt'])
        && request.resource.data.schema == 'danbridge-immutable-migration-backup-v2'
        && request.resource.data.environment == 'staging'
        && request.resource.data.state == 'verified'
        && request.resource.data.backupId == runId
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.sourceHash.size() == 64
        && request.resource.data.sourceVersionHash is string
        && request.resource.data.sourceVersionHash.size() > 0
        && request.resource.data.verifiedHash == request.resource.data.sourceHash
        && request.resource.data.collectionOrder is list
        && request.resource.data.collectionOrder.size() == 16
        && request.resource.data.collections is map
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 0
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount >= 0
        && request.resource.data.maxChunkBytes is int
        && request.resource.data.maxChunkBytes >= 4096
        && request.resource.data.maxChunkBytes <= 180000
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedByEmail == emailKey()
        && request.resource.data.verifiedAt == request.time;
      allow update, delete: if false;
    }

    match /stagingMigrationBackups/{companyId}/runs/{runId}/chunks/{chunkId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['schema','environment','backupId','chunkId','collection','index','items','sourceHash','sourceVersionHash','createdAt','createdBy','createdByEmail'])
        && request.resource.data.schema == 'danbridge-immutable-migration-backup-chunk-v2'
        && request.resource.data.environment == 'staging'
        && request.resource.data.backupId == runId
        && request.resource.data.chunkId == chunkId
        && request.resource.data.collection in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.items is list
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() > 0
        && request.resource.data.sourceHash.size() == 64
        && request.resource.data.sourceVersionHash is string
        && request.resource.data.sourceVersionHash.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == emailKey();
      allow update, delete: if false;
    }

    // 隔離復原演練只寫入專用沙盒；不允許覆寫、刪除或成為正式讀取來源。
    match /stagingMigrationRestoreDrills/{companyId}/runs/{drillId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['schema','environment','state','drillId','sourceBackupId','sourceHash','restoredHash','sourceChunkCount','restoredChunkCount','recordCount','collections','mainVersionHash','mainUnchanged','verifiedAt','verifiedBy','verifiedByEmail'])
        && request.resource.data.schema == 'danbridge-migration-restore-drill-v1'
        && request.resource.data.environment == 'staging'
        && request.resource.data.state == 'verified'
        && request.resource.data.drillId == drillId
        && request.resource.data.sourceBackupId is string
        && request.resource.data.sourceBackupId.size() > 0
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() == 64
        && request.resource.data.restoredHash == request.resource.data.sourceHash
        && request.resource.data.sourceChunkCount is int
        && request.resource.data.sourceChunkCount >= 0
        && request.resource.data.restoredChunkCount == request.resource.data.sourceChunkCount
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount >= 0
        && request.resource.data.collections is map
        && request.resource.data.mainVersionHash is string
        && request.resource.data.mainVersionHash.size() > 0
        && request.resource.data.mainUnchanged == true
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedByEmail == emailKey();
      allow update, delete: if false;
    }

    match /stagingMigrationRestoreDrills/{companyId}/runs/{drillId}/chunks/{chunkId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['schema','environment','backupId','sourceBackupId','chunkId','collection','index','items','sourceHash','sourceVersionHash','createdAt','createdBy','createdByEmail'])
        && request.resource.data.schema == 'danbridge-immutable-migration-backup-chunk-v2'
        && request.resource.data.environment == 'staging'
        && request.resource.data.backupId == drillId
        && request.resource.data.sourceBackupId is string
        && request.resource.data.sourceBackupId.size() > 0
        && request.resource.data.chunkId == chunkId
        && request.resource.data.collection in ['students','teachers','lessons','makeups','changes','teacherGroups','winterTeacherGroups','summerCampClasses','summerCampRegistrations','winterCampRegistrations','winterCampClasses','settlementRecords','fixedExpenses','oneTimeExpenses','collectionRecords','branches']
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.items is list
        && request.resource.data.sourceHash is string
        && request.resource.data.sourceHash.size() == 64
